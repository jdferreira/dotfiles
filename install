#!/usr/bin/env bash
set -euo pipefail

source "$(dirname -- "$(readlink -f -- "$0")")/scripts/lib.sh"

usage() {
    echo 'Usage: ./install --dotfiles --preferences'
    echo '  --apt --brew --docker --apps --firefox --keyboard --remove-snap-flatpak --check-repos'
    echo 'System operations always ask for confirmation'
}

steps=()

while (($#)); do
    case $1 in
        --help|-h) usage; exit 0 ;;
        --dotfiles|--preferences|--apt|--brew|--docker|--apps|--firefox|--keyboard|--remove-snap-flatpak|--check-repos) steps+=("${1#--}") ;;
        *) usage; exit 2 ;;
    esac
    shift
done

((${#steps[@]})) || { usage; exit 2; }
trap 'echo "Installation failed at line $LINENO. Resolve the error and rerun the selected step." >&2' ERR

for step in "${steps[@]}"; do
    case $step in
        dotfiles)
            for file in .bashrc .vimrc; do link_file "$ROOT/$file" "$HOME/$file"; done

            # Git config is private; never link a missing/public identity template.
            echo 'Git configuration unchanged. Restore it with scripts/backup-private-data.sh restore git-config ARCHIVE.'
            ;;
        apt) "$ROOT/scripts/new-laptop-install-apt-packages.sh" ;;
        docker) "$ROOT/scripts/new-laptop-install-docker.sh" ;;
        brew|apps|firefox|keyboard|remove-snap-flatpak) "$ROOT/scripts/new-laptop-install-software.sh" "$step" ;;
        preferences) "$ROOT/scripts/new-laptop-restore-preferences.sh" ;;
        check-repos) "$ROOT/scripts/old-laptop-check-repos.sh" ;;
    esac
done
